{
  "name": "kotonoha",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Extensión de navegador para aprender japonés con video y texto real: subtítulos interactivos, diccionario, tarjetas y explicaciones con Claude.",
  "scripts": {
    "build": "node build.mjs",
    "paquete": "node herramientas/empaquetar.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node pruebas/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@breezystack/lamejs": "^1.2.7",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "@huggingface/transformers": "^4.3.2",
    "@preact/signals": "^2.11.4",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "kuromoji": "^0.1.2",
    "preact": "^11.1.1",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "author": "Eliam Mojardin Ibarra",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eliam4510/kotonoha.git"
  },
  "homepage": "https://github.com/Eliam4510/kotonoha#readme",
  "keywords": [
    "japanese",
    "language-learning",
    "browser-extension",
    "manifest-v3",
    "subtitles",
    "anki",
    "whisper",
    "webgpu",
    "claude"
  ]
}
